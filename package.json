{
	"name": "redwatchface-tools",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Build tooling for the redPlant Blob watch face. Not shipped in the APK.",
	"scripts": {
		"gen": "node tools/gen/build.ts",
		"check": "node tools/gen/build.ts --check",
		"diff": "node tools/gen/build.ts --diff",
		"snapshot": "node tools/gen/build.ts --snapshot",
		"selftest": "node tools/gen/build.ts --selftest",
		"audit": "node tools/gen/build.ts --audit",
		"equiv": "node tools/gen/build.ts --equiv",
		"svg": "node tools/gen/build.ts --svg",
		"typecheck": "tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"verify": "npm run typecheck && npm run lint && npm run test && npm run selftest && npm run diff && npm run check",
		"build": "node tools/device-cli.ts gradle :watchface:assembleDebug",
		"validate": "node tools/device-cli.ts gradle :watchface:validateWatchFaceXml",
		"footprint": "node tools/device-cli.ts gradle :watchface:checkMemoryFootprint",
		"release": "node tools/device-cli.ts gradle :watchface:assembleRelease",
		"devices": "node tools/device-cli.ts devices",
		"deploy": "node tools/device-cli.ts install",
		"deploy:fresh": "node tools/device-cli.ts uninstall && node tools/device-cli.ts install",
		"activate": "node tools/device-cli.ts activate",
		"preview": "npm --prefix tools/preview run dev",
		"preview:check": "node tools/preview/check.ts",
		"preview:png": "node tools/device-cli.ts shot watchface/src/main/res/drawable/preview.png",
		"postinstall": "node ./submodules/hhson-lib/scripts/link-skills.mjs"
	},
	"dependencies": {
		"hhson-lib": "file:./submodules/hhson-lib"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "^26.2.0",
		"eslint": "10.0.2",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.4.0",
		"prettier": "3.8.1",
		"sharp": "^0.35.3",
		"typescript": "^5.9.2",
		"typescript-eslint": "8.56.1",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=22.18"
	}
}
