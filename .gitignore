.gradle/
build/
local.properties
.idea/
*.iml
.DS_Store

# Verification tools are downloaded, not vendored (see README)
tools/*.jar

# Generator toolchain. package-lock.json IS committed - the whole point of
# pinning typescript is that the type check is the same on the next machine.
# node_modules/ with no leading slash matches at any depth, so it covers
# tools/preview's own install too.
node_modules/

# The preview is a dev server, never a build artefact.
tools/preview/dist/

# Per-machine Claude Code permissions, holding absolute JDK and SDK paths. The skill symlinks
# next to it ARE committed. This was only ever ignored via a global ~/.config/git/ignore, which
# is one machine's luck rather than a property of the repo.
.claude/settings.local.json
