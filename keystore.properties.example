# Copy to keystore.properties - which is gitignored - and fill in the four values.
# `npm run release` fails with a pointer here if the file is missing.
#
# The keytool line that creates the store is in docs/device.md, "Handing the face
# to someone else". Read that section before generating one: this key has to sign
# every future build of the face, and there is no recovery if it is lost.

# Resolved relative to the repo root; an absolute path works too. Keep the store
# itself OUT of the working tree - *.jks is gitignored precisely so a slip does
# not commit it, but "not committed" is not the same as "backed up".
storeFile=../redblob-release.jks
storePassword=
keyAlias=redblob
keyPassword=
